{
  "name": "@saberbird/linefont",
  "version": "0.0.1",
  "description": "Single-line vector fonts and text layout for linefont/1",
  "license": "MIT AND CC-BY-4.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "repository": { "type": "git", "url": "git+https://github.com/SABERBIRD/lineFONT.git" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./fonts/bagling-ua-en": { "types": "./bindings/js/bagling-font.d.mts", "default": "./bindings/js/bagling-font.mjs" },
    "./fonts/bagling-greek-letters": { "types": "./bindings/js/greek-font.d.mts", "default": "./bindings/js/greek-font.mjs" },
    "./fonts/bagLING-UA-EN.lint": "./fonts/bagLING-UA-EN/bagLING-UA-EN.lint",
    "./fonts/bagLING-Greek-Letters.lint": "./fonts/bagLING-Greek-Letters/bagLING-Greek-Letters.lint"
  },
  "bin": { "linefont-validate": "./tools/validate-linefont.mjs" },
  "files": ["dist/", "bindings/js/*font.*", "fonts/*/*.lint", "fonts/*/README.md", "examples/", "spec/", "tools/validate-linefont.mjs", "LICENSES/", "THIRD_PARTY.txt"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/copy-wasm.mjs",
    "test": "node --test tests/*.test.mjs",
    "font:validate": "node tools/validate-linefont.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": { "typescript": "5.9.3" }
}

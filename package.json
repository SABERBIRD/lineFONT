{
  "name": "@saberbird/linefont",
  "version": "0.0.3",
  "description": "Single-line vector fonts and text layout for lineFONT",
  "license": "MIT AND CC-BY-4.0 AND Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SABERBIRD/lineFONT.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fonts/bagling-ua-en": {
      "types": "./bindings/js/bagling-font.d.mts",
      "default": "./bindings/js/bagling-font.mjs"
    },
    "./fonts/bagling-greek-letters": {
      "types": "./bindings/js/greek-font.d.mts",
      "default": "./bindings/js/greek-font.mjs"
    },
    "./fonts/bagLING-UA-EN.lint": "./fonts/bagLING-UA-EN/bagLING-UA-EN.lint",
    "./fonts/bagLING-Greek-Letters.lint": "./fonts/bagLING-Greek-Letters/bagLING-Greek-Letters.lint"
  },
  "bin": {
    "linefont-validate": "./tools/validate-linefont.mjs",
    "linefont-preview": "./tools/preview-linefont.mjs",
    "linefont-coverage": "./tools/coverage-linefont.mjs"
  },
  "files": [
    "dist/",
    "bindings/js/*font.*",
    "fonts/*/*.lint",
    "fonts/*/README.md",
    "examples/",
    "spec/",
    "docs/",
    "core/include/linefont.h",
    "core/rust-toolchain.toml",
    "CONTRIBUTING.md",
    "RELEASE_NOTES.md",
    "ROADMAP.md",
    "tools/validate-linefont.mjs",
    "LICENSES/",
    "THIRD_PARTY.txt",
    "tools/preview-*.mjs",
    "tools/preview.css",
    "tools/preview-language-samples.*",
    "tools/coverage-linefont.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/copy-wasm.mjs",
    "test": "node --test tests/*.test.mjs",
    "font:validate": "node tools/validate-linefont.mjs",
    "prepack": "npm run build",
    "font:preview": "node tools/preview-linefont.mjs",
    "font:coverage": "node tools/coverage-linefont.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
